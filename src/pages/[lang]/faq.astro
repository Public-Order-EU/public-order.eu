---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import type { Locale } from '../../i18n/locales';
import { getDictionary, getLocalizedFaq, isLocaleComplete, localePath, localeStaticPaths } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
const { entry, isFallback, translated } = await getLocalizedFaq(lang);
const contentLang = isFallback ? 'en' : lang;

/** Answers are plain text; blank lines separate paragraphs. */
const paragraphs = (text: string) =>
  text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);

const items = entry.data.items;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: contentLang,
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: paragraphs(item.a).join('\n\n') },
  })),
};
---

<BaseLayout
  lang={lang}
  slug="faq"
  title={t.faq.title}
  description={t.faq.lead}
  translated={translated}
  isFallback={isFallback || !isLocaleComplete(lang)}
  jsonLd={isFallback ? [] : [faqJsonLd]}
>
  <PageIntro title={t.faq.title} lead={t.faq.lead} />

  <div class="container-page py-12 md:py-16">
    <div class="max-w-3xl">
      <div class="divide-y divide-rule border-y border-rule dark:divide-navy-800 dark:border-navy-800" lang={contentLang}>
        {
          items.map((item, i) => (
            <details class="group" id={`q${i + 1}`}>
              <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-4 py-5 font-serif text-xl leading-snug font-semibold text-navy-900 marker:hidden hover:text-navy-700 dark:text-white dark:hover:text-navy-200 [&::-webkit-details-marker]:hidden">
                <span>{item.q}</span>
                <svg viewBox="0 0 24 24" class="mt-1 size-5 shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <div class="max-w-2xl space-y-4 pb-7 text-slate-800 dark:text-slate-300">
                {paragraphs(item.a).map((p) => <p>{p}</p>)}
              </div>
            </details>
          ))
        }
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        <a href={`${localePath(lang)}#sign`} class="btn-primary">{t.nav.sign}</a>
        <a href={localePath(lang, 'petition')} class="btn-secondary">{t.home.readFull}</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Open the question linked from the URL hash (e.g. /en/faq/#q4).
  const target = location.hash && document.querySelector<HTMLDetailsElement>(`details${location.hash}`);
  if (target) target.open = true;
</script>
