---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignatureForm from '../../components/SignatureForm.astro';
import SignatureCounter from '../../components/SignatureCounter.astro';
import KeyPoints from '../../components/KeyPoints.astro';
import RightsStatement from '../../components/RightsStatement.astro';
import type { Locale } from '../../i18n/locales';
import { getDictionary, localePath, localeStaticPaths } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
---

<BaseLayout lang={lang} slug="" title={t.home.title}>
  <!-- Hero + signature form -->
  <section class="border-b border-rule dark:border-navy-800">
    <div class="container-page grid gap-12 py-12 md:py-16 lg:grid-cols-[1fr_minmax(0,27rem)] lg:gap-16 lg:py-20">
      <div>
        <p class="eyebrow">{t.home.eyebrow}</p>
        <h1 class="mt-4 text-4xl leading-[1.08] font-semibold tracking-tight sm:text-5xl lg:text-[3.5rem]">
          {t.home.headline}
        </h1>
        <p class="lead mt-6 max-w-2xl">{t.home.lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#sign" class="btn-primary lg:hidden">{t.home.ctaButton}</a>
          <a href={localePath(lang, 'petition')} class="btn-secondary">{t.home.readFull}</a>
        </div>
        <SignatureCounter lang={lang} class="mt-12 max-w-xl border-t border-rule pt-6 dark:border-navy-800" />
      </div>

      <div id="sign" class="box self-start border-t-4 border-t-navy-800 dark:border-t-accent-400">
        <h2 class="text-2xl font-semibold">{t.form.title}</h2>
        <p class="mt-1 mb-6 text-sm text-slate-700 dark:text-slate-400">{t.form.intro}</p>
        <SignatureForm lang={lang} />
      </div>
    </div>
  </section>

  <!-- Key points -->
  <section class="container-page grid gap-8 py-16 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16 lg:py-20" aria-labelledby="points-title">
    <!-- On wide screens the heading stays in view (below the sticky header) while the proposals scroll past. -->
    <div class="lg:sticky lg:top-24 lg:self-start">
      <h2 id="points-title" class="section-title">{t.home.pointsTitle}</h2>
      <p class="mt-4 text-slate-700 dark:text-slate-300">{t.home.pointsIntro}</p>
      <p class="mt-6">
        <a href={localePath(lang, 'petition')} class="link">{t.home.readFull}</a>
      </p>
    </div>
    <KeyPoints lang={lang} />
  </section>

  <!-- Goal + rights -->
  <section class="bg-paper-deep py-16 lg:py-20 dark:bg-navy-900/60" aria-labelledby="goal-title">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <div>
        <h2 id="goal-title" class="section-title">{t.home.goalTitle}</h2>
        <p class="mt-4 text-lg text-slate-700 dark:text-slate-300">{t.home.goalText}</p>
      </div>
      <RightsStatement lang={lang} />
    </div>
  </section>

  <!-- Call to action -->
  <section class="on-dark bg-navy-900 text-slate-200 dark:bg-navy-900" aria-labelledby="cta-title">
    <div class="container-page grid gap-10 py-14 md:grid-cols-2 md:gap-16">
      <div>
        <h2 id="cta-title" class="text-2xl font-semibold text-white">{t.home.ctaTitle}</h2>
        <p class="mt-3 max-w-md">{t.home.ctaText}</p>
        <a href="#sign" class="btn-light mt-6">{t.home.ctaButton}</a>
      </div>
      <div class="border-t border-white/20 pt-10 md:border-t-0 md:border-l md:pt-0 md:pl-16">
        <h2 class="text-2xl font-semibold text-white">{t.home.shareTitle}</h2>
        <p class="mt-3 max-w-md">{t.home.shareText}</p>
        <a href={localePath(lang, 'share')} class="btn-secondary mt-6 border-white/60 text-white hover:bg-paper hover:text-navy-950">
          {t.home.shareButton}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
