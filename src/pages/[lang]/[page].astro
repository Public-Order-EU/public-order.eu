---
/**
 * Long-form pages written in Markdown: src/content/pages/{lang}/{slug}.md.
 * A missing translation falls back to English (with a notice).
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { locales, type Locale } from '../../i18n/locales';
import { getDictionary, getLocalizedPage, isLocaleComplete, localePath } from '../../i18n/utils';

export function getStaticPaths() {
  // Long-form pages from src/content/pages/<lang>/<page>.md (defined inline: getStaticPaths is hoisted).
  const pages = ['petition', 'privacy', 'legal'] as const;
  return locales.flatMap((lang) => pages.map((page) => ({ params: { lang, page } })));
}

const lang = Astro.params.lang as Locale;
const page = Astro.params.page as 'petition' | 'privacy' | 'legal';
const t = getDictionary(lang);

const { entry, isFallback, translated } = await getLocalizedPage(page, lang);
const { Content } = await render(entry);
const contentLang = isFallback ? 'en' : lang;
const updated = entry.data.updated
  ? new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(entry.data.updated)
  : undefined;

const isPetition = page === 'petition';
---

<BaseLayout
  lang={lang}
  slug={page}
  title={entry.data.title}
  description={entry.data.description}
  translated={translated}
  isFallback={isFallback || !isLocaleComplete(lang)}
  ogType={isPetition ? 'article' : 'website'}
>
  <article>
    <PageIntro title={entry.data.title} contentLang={contentLang}>
      {
        updated && (
          <p class="mt-4 text-sm text-slate-700 dark:text-slate-400">
            <time datetime={entry.data.updated?.toISOString().slice(0, 10)}>{updated}</time>
          </p>
        )
      }
    </PageIntro>

    <div class="container-page py-12 md:py-16">
      <div
        lang={contentLang}
        class="prose max-w-3xl prose-slate sm:prose-lg dark:prose-invert prose-headings:font-semibold prose-headings:text-navy-900 prose-a:font-semibold prose-a:text-navy-800 prose-a:decoration-1 prose-a:underline-offset-[0.2em] hover:prose-a:decoration-2 prose-strong:text-ink prose-table:text-base prose-th:border-rule prose-td:border-rule prose-hr:border-rule dark:prose-headings:text-white dark:prose-a:text-navy-200 dark:prose-strong:text-white"
      >
        <Content />
      </div>
    </div>

    {
      isPetition && (
        <div class="on-dark bg-navy-900">
          <div class="container-page flex flex-col items-start gap-5 py-12 sm:flex-row sm:items-center sm:justify-between">
            <p class="font-serif text-2xl font-semibold text-white">{t.petition.signCta}</p>
            <a href={`${localePath(lang)}#sign`} class="btn-light">{t.nav.sign}</a>
          </div>
        </div>
      )
    }
  </article>
</BaseLayout>
