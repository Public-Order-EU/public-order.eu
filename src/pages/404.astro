---
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLocale, localeInfo, localesByNativeName } from '../i18n/locales';
import { getDictionary, localePath } from '../i18n/utils';

const lang = defaultLocale;
const t = getDictionary(lang);
---

<BaseLayout lang={lang} slug="404" title={t.notFound.title} noindex translated={[]}>
  <div class="container-page py-16 md:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{t.notFound.title}</h1>
      <p class="lead mt-5">{t.notFound.text}</p>
      <a href={localePath(lang)} class="btn-primary mt-8">{t.notFound.back}</a>
    </div>
    <ul class="mt-14 grid max-w-3xl grid-cols-2 border-t border-rule sm:grid-cols-3 dark:border-navy-800">
      {
        localesByNativeName.map((l) => (
          <li class="border-b border-rule dark:border-navy-800">
            <a href={localePath(l)} hreflang={l} lang={l} class="flex min-h-11 items-center py-2 pr-3 font-medium text-navy-800 underline-offset-[0.2em] hover:underline dark:text-navy-200">
              {localeInfo[l].nativeName}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
