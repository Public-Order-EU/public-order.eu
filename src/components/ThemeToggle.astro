---
interface Props {
  /** Accessible name of the toggle ("Dark mode"); aria-pressed carries the state. */
  label: string;
  title?: string;
  buttonClass?: string;
}
const { label, title = label, buttonClass } = Astro.props;
---

<!-- Hidden without JavaScript (the theme then simply follows the system setting). -->
<button type="button" data-theme-toggle hidden aria-label={label} aria-pressed="false" title={title} class={buttonClass}>
  <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    const sync = () => btn.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));
    sync();
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      sync();
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        /* storage unavailable — the choice just isn't remembered */
      }
    });
  });
</script>
