---
import type { Locale } from '../i18n/locales';
import { getDictionary } from '../i18n/utils';

interface Props {
  lang: Locale;
  class?: string;
}
const { lang, class: className } = Astro.props;
const t = getDictionary(lang);
---

<aside class:list={['border-l-4 border-accent-500 pl-6 sm:pl-8', className]} aria-labelledby="rights-title">
  <h2 id="rights-title" class="eyebrow font-sans">{t.rights.title}</h2>
  <p class="mt-3 font-serif text-xl leading-relaxed text-ink sm:text-[1.375rem] dark:text-slate-100">{t.rights.text}</p>
</aside>
